input {
    keyboard {
        xkb {
            layout "us"
            model ""
            rules ""
            variant ""
        }
        repeat-delay 600
        repeat-rate 25
        track-layout "global"
    }
    touchpad {
        tap
        drag true
        // The physical click depends on touchpad-rebind.service in
        // modules/hosts/nixps/touchpad.nix — without that rebind the
        // pad intermittently reports no button press at all, and this
        // setting has nothing to act on.
        click-method "clickfinger"
        natural-scroll
        accel-speed -0.150000
        accel-profile "adaptive"
        scroll-factor 0.500000
    }
    mouse {
        accel-speed -0.150000
        accel-profile "adaptive"
        scroll-factor 0.500000
    }
}
output "eDP-1" {
    scale 1.0
    transform "normal"
    mode "1920x1200@120.043000"
    variable-refresh-rate
}
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
prefer-no-csd
// Without clip-to-geometry the window contents still paint square corners
// underneath the rounded geometry.
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}
// noctalia is started by its systemd user service; adding spawn-at-startup
// would run two copies.
// https://docs.noctalia.dev/v5/compositor-settings/niri/
// Required by noctalia: lets it act on notification buttons and raise
// windows, which otherwise fail the xdg-activation serial check.
debug {
    honor-xdg-activation-with-invalid-serial
}
layer-rule {
    match namespace="^noctalia-overview*"
    place-within-backdrop true
}
layout {
    gaps 8
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
    // Border is off, so this ring is the only focus indication.
    focus-ring {
        width 2
        active-color "@focusActive@"
        inactive-color "@focusInactive@"
    }
    border { off; }
    default-column-width { proportion 0.500000; }
    preset-column-widths {
        proportion 0.333330
        proportion 0.500000
        proportion 0.666670
    }
    center-focused-column "never"
}
cursor {
    xcursor-theme "@cursorTheme@"
    // niri stamps XCURSOR_SIZE onto every client it spawns, so this value
    // wins over the one home-manager exports.
    xcursor-size @cursorSize@
}
switch-events {
    lid-close { spawn "@handleLidClose@"; }
}
binds {
    Alt+1 { focus-workspace 1; }
    Alt+2 { focus-workspace 2; }
    Alt+3 { focus-workspace 3; }
    Alt+4 { focus-workspace 4; }
    Alt+B hotkey-overlay-title="Browser: helium" { spawn "helium"; }
    Alt+T hotkey-overlay-title="Terminal: rio" { spawn "rio"; }
    Alt+Down { focus-window-down; }
    Alt+H { focus-column-left; }
    Alt+J { focus-window-down; }
    Alt+K { focus-window-up; }
    Alt+L { focus-column-right; }
    Alt+Left { focus-column-left; }
    Alt+Right { focus-column-right; }
    Alt+Up { focus-window-up; }
    Alt+F { maximize-column; }
    Alt+R { switch-preset-column-width; }
    Alt+Shift+F { fullscreen-window; }
    Alt+Q { close-window; }
    Alt+Shift+E { quit; }
    Alt+Shift+L { spawn-sh "noctalia msg session lock"; }
    Alt+Shift+P { power-off-monitors; }
    XF86Sleep allow-when-locked=true { spawn "@noctalia@" "msg" "session" "lock-and-suspend"; }
    Alt+Shift+1 { move-column-to-workspace 1; }
    Alt+Shift+2 { move-column-to-workspace 2; }
    Alt+Shift+3 { move-column-to-workspace 3; }
    Alt+Shift+4 { move-column-to-workspace 4; }
    Alt+Shift+Down { move-window-down; }
    Alt+Shift+Left { move-column-left; }
    Alt+Shift+Right { move-column-right; }
    Alt+Shift+Up { move-window-up; }
    Alt+Print { screenshot-window; }
    Print { screenshot; }
    Alt+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Alt+S { spawn-sh "noctalia msg panel-toggle control-center"; }
    Alt+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab { spawn-sh "noctalia msg window-switcher"; }
    // Routed through noctalia because its OSD only fires for changes
    // noctalia itself makes.
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }
    XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up"; }
}
